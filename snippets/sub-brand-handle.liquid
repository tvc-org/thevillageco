{% comment %}
  Sub brand handle for the current page, product, or collection.

  Products: vendor Hallu (any casing) → hallu. No product metafield.

  Collections: title contains "Hallu:" (any casing) → hallu. No collection metafield.

  Pages: metafield custom.sub_brand (single-line text choice, e.g. Hallu → hallu).
  Storefront access on the definition must be Read.
{% endcomment %}
{%- liquid
  assign sub_brand = blank
  if request.page_type == 'product'
    assign product_vendor_handle = product.vendor | handleize
    if product_vendor_handle == 'hallu'
      assign sub_brand = 'Hallu'
    endif
  elsif request.page_type == 'collection'
    assign collection_title_down = collection.title | downcase
    if collection_title_down contains 'hallu:'
      assign sub_brand = 'Hallu'
    endif
  elsif request.page_type == 'page'
    assign sub_brand = page.metafields.custom.sub_brand.value | default: page.metafields.custom.sub_brand
  endif
  assign sub_brand_handle = sub_brand | strip | handleize
-%}
{%- if sub_brand_handle != blank -%}
  {{- sub_brand_handle -}}
{%- endif -%}
