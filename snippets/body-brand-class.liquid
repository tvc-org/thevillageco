{% comment %}
  Class for <body> (see layout/theme.liquid).

  Header brands still come from snippets/resolve-brand-handle.liquid.
  When a sub brand is set, this class is the sub brand (Hallu → hallu) and the
  header brand resolves to The Village Co. so header-brand styles do not apply.
{% endcomment %}
{%- capture sub_brand_handle -%}
  {%- render 'sub-brand-handle' -%}
{%- endcapture -%}
{%- assign sub_brand_handle = sub_brand_handle | strip -%}
{%- if sub_brand_handle contains 'Liquid error' -%}
  {%- assign sub_brand_handle = blank -%}
{%- endif -%}
{%- if sub_brand_handle != blank -%}
  {{- sub_brand_handle -}}
{%- else -%}
  {%- capture brand_body_handle -%}
    {%- render 'resolve-brand-handle' -%}
  {%- endcapture -%}
  {%- assign brand_body_handle = brand_body_handle | strip -%}
  {%- if brand_body_handle != blank %} {{ brand_body_handle }}{% endif -%}
{%- endif -%}
