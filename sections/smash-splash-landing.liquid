{{ 'section-smash-splash.css' | asset_url | stylesheet_tag }}

{%- comment -%} IFRAME RESIZER — load early (test page places this in <head>) {%- endcomment -%}
<script src="https://mrbubble.kpicentral.com/js/iframeResizer.min.js" defer></script>

<section
  class="smash-splash{% if section.settings.kits_claimed %} smash-splash--kits-claimed smash-splash--copy-updated{% endif %}"
  aria-label="Smash & Splash Birthday Bash"
>
  {%- comment -%} Hero {%- endcomment -%}
  <div
    class="smash-splash__hero"
    style="--ss-hero-desktop: url('{{ 'bday-banner-desktop.jpg' | asset_url }}');"
  >
    <div class="smash-splash__hero-inner">
      <img
        class="smash-splash__logo"
        src="{{ 'bday-smash-splash.png' | asset_url }}"
        alt="Mr. Bubble Smash & Splash Birthday Bash"
        width="760"
        height="320"
      >

      {%- if section.settings.kits_claimed -%}
        {%- comment -%} Phase 3: all 100 kits claimed — admin toggle {%- endcomment -%}
        <h1 class="smash-splash__headline" data-ss-copy="headline">
          Keep celebrating all year long with Mr.Bubble.
        </h1>
        <div class="smash-splash__copy" data-ss-copy="body">
          <p>
            Our Smash & Splash Kits have all been spoken for but the good times and bubbles keep coming!
          </p>
          <p>
            Enjoy this coupon and see for yourself how Mr.Bubble makes getting clean MORE FUN than getting dirty.®
          </p>
        </div>
      {%- else -%}
        {%- comment -%}
          Timed copy swap at 2026-08-07 08:00 America/New_York (client-side; CDN cache bypass).
          Preview claim-kit copy anytime with ?copyUpdatePreview=true
          Pre-cutover = reminder CTA; post-cutover = claim kit.
        {%- endcomment -%}
        <h1 class="smash-splash__headline" data-ss-copy="headline">Get a reminder before the party starts!</h1>

        <div class="smash-splash__copy" data-ss-copy="body">
          <p>Mr. Bubble is turning 65 and we’re giving away limited-edition Smash & Splash Kits to celebrate.</p>
          <p>
            The kits feature DIY smash cake fixins and birthday-themed bath-time goodies that make getting clean MORE FUN
            than getting dirty.®
          </p>
          <p>
            <strong
              >Sign up below and we’ll send you a reminder so you don’t miss your chance to join the birthday bash.</strong
            >
          </p>
        </div>

        <template id="smash-splash-copy-after">
          <h1 class="smash-splash__headline" data-ss-copy="headline">Keep the party going at home.</h1>
          <div class="smash-splash__copy" data-ss-copy="body">
            <p>
              Be one of the first 100 people to sign up and claim a limited-edition Smash & Splash Kit to celebrate
              Mr. Bubble turning 65.
            </p>
            <p>
              The kit features DIY smash cake fixins and birthday-themed, bath-time goodies that make getting clean MORE
              FUN than getting dirty.®
            </p>
            <p><strong>Don’t wait! Claim yours today and be part of the fun.</strong></p>
          </div>
        </template>
      {%- endif -%}
    </div>

    <img
      class="smash-splash__hero-mobile-img"
      src="{{ 'bday-banner-mobile.jpg' | asset_url }}"
      alt=""
      width="800"
      height="800"
      loading="eager"
    >
  </div>

  {%- comment -%} Repeating ticker {%- endcomment -%}
  <div class="smash-splash__marquee" aria-hidden="true">
    <div class="smash-splash__marquee-track">
      <p class="smash-splash__marquee-text">
        SMASH, SPLASH, CELEBRATE! SMASH, SPLASH, CELEBRATE! SMASH, SPLASH, CELEBRATE!
      </p>
      <p class="smash-splash__marquee-text">
        SMASH, SPLASH, CELEBRATE! SMASH, SPLASH, CELEBRATE! SMASH, SPLASH, CELEBRATE!
      </p>
    </div>
  </div>

  {%- comment -%} What you could win {%- endcomment -%}
  <div class="smash-splash__prizes">
    <h2 class="smash-splash__prizes-title">What you could win:</h2>
    <ul class="smash-splash__prize-grid">
      <li class="smash-splash__prize">
        <img
          class="smash-splash__prize-icon"
          src="{{ 'bday-icon-cake.png' | asset_url }}"
          alt=""
          width="200"
          height="200"
          loading="lazy"
        >
        <span class="smash-splash__prize-label"
          >DIY Cake<br>
          Decorating Kit</span
        >
      </li>
      <li class="smash-splash__prize">
        <img
          class="smash-splash__prize-icon"
          src="{{ 'bday-icon-foam.png' | asset_url }}"
          alt=""
          width="200"
          height="200"
          loading="lazy"
        >
        <span class="smash-splash__prize-label"
          >Birthday<br>
          Foam Soap</span
        >
      </li>
      <li class="smash-splash__prize">
        <img
          class="smash-splash__prize-icon"
          src="{{ 'bday-icon-party-pup.png' | asset_url }}"
          alt=""
          width="200"
          height="200"
          loading="lazy"
        >
        <span class="smash-splash__prize-label"
          >Party Pup<br>
          Bubble Bath</span
        >
      </li>
      <li class="smash-splash__prize">
        <img
          class="smash-splash__prize-icon"
          src="{{ 'bday-icon-bath-bomb.png' | asset_url }}"
          alt=""
          width="200"
          height="200"
          loading="lazy"
        >
        <span class="smash-splash__prize-label"
          >Mr. Bubble<br>
          Bath Bomb</span
        >
      </li>
    </ul>
  </div>

  {%- comment -%}
    Split: form first in DOM for mobile; CSS order swaps to visual | form on desktop.
  {%- endcomment -%}
  <div class="smash-splash__split">
    <div class="smash-splash__form-col">
      <div class="smash-splash__form-shell">
        <iframe
          id="smash-splash-entry-iframe"
          src="https://mrbubble.kpicentral.com/"
          title="Smash & Splash Birthday Bash entry form"
          width="100%"
          scrolling="no"
        ></iframe>
      </div>
    </div>

    <div class="smash-splash__visual-col">
      <img
        src="{{ 'bday-65.jpg' | asset_url }}"
        alt="Mr. Bubble celebrating 65 years with balloons and a gift"
        width="1200"
        height="1200"
        loading="lazy"
      >
    </div>
  </div>
</section>

{%- comment -%} IFRAME RESIZER — init as close to end of body content as section allows {%- endcomment -%}
<script>
  (function () {
    var iframeSelector = '#smash-splash-entry-iframe';

    function initSmashSplashIframe() {
      if (typeof iFrameResize !== 'function') return;
      iFrameResize({ log: false, checkOrigin: false }, iframeSelector);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSmashSplashIframe);
    } else {
      initSmashSplashIframe();
    }

    // Deferred script may finish after DOMContentLoaded
    window.addEventListener('load', initSmashSplashIframe);
  })();
</script>

{%- unless section.settings.kits_claimed -%}
  {%- comment -%} Timed hero copy swap — 8:00 AM Eastern on 2026-08-07; ?copyUpdatePreview=true to force {%- endcomment -%}
  <script>
    (function () {
      var CUTOVER_MS = Date.parse('2026-08-07T08:00:00-04:00');
      var template = document.getElementById('smash-splash-copy-after');
      if (!template) return;

      var params = new URLSearchParams(window.location.search);
      var forcePreview = params.get('copyUpdatePreview') === 'true';

      function applyAfterCopy() {
        var root = document.querySelector('.smash-splash');
        var nodes = template.content.cloneNode(true);
        var nextHeadline = nodes.querySelector('[data-ss-copy="headline"]');
        var nextBody = nodes.querySelector('[data-ss-copy="body"]');
        var headline = document.querySelector('.smash-splash [data-ss-copy="headline"]');
        var body = document.querySelector('.smash-splash [data-ss-copy="body"]');

        if (headline && nextHeadline) headline.replaceWith(nextHeadline);
        if (body && nextBody) body.replaceWith(nextBody);
        if (root) root.classList.add('smash-splash--copy-updated');
      }

      if (forcePreview || Date.now() >= CUTOVER_MS) {
        applyAfterCopy();
        return;
      }

      var msUntil = CUTOVER_MS - Date.now();
      // Cap setTimeout (some browsers clamp very large delays)
      if (msUntil < 2147483647) {
        setTimeout(applyAfterCopy, msUntil);
      }
    })();
  </script>
{%- endunless -%}

{% schema %}
{
  "name": "Smash & Splash Landing",
  "tag": "div",
  "class": "section-smash-splash",
  "settings": [
    {
      "type": "checkbox",
      "id": "kits_claimed",
      "label": "Kits claimed",
      "info": "Turn on when all 100 Smash & Splash Kits are spoken for. Shows the sold-out / coupon copy and skips the timed claim-kit swap.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Smash & Splash Landing",
      "category": "Custom Content"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
