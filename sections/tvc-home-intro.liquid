{{ 'section-tvc-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-tvc-home-intro.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lottie-player.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tvc-home-intro.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign tvc_section_anchor = section.settings.anchor_id | strip | remove: '#' | handleize
-%}

<div
  class="tvc-home-intro"
  {% if tvc_section_anchor != blank %}
    id="{{ tvc_section_anchor }}"
  {% endif %}
>
  <div class="tvc-home-intro__grid">
    <div class="tvc-home-intro__content">
      <div
        class="tvc-home-intro__content-inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: 1;"
        {% endif %}
      >
        {%- if section.settings.pre_title != blank -%}
          <p class="tvc-pretitle">{{ section.settings.pre_title | escape }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="tvc-home-intro__title mt-2 mb-4 lg-mb-6">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="tvc-home-intro__body rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.secondary_title != blank -%}
          <h3 class="tvc-home-intro__secondary-title">{{ section.settings.secondary_title | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.secondary_text != blank -%}
          <div class="tvc-home-intro__secondary-text rte">{{ section.settings.secondary_text }}</div>
        {%- endif -%}
      </div>
    </div>

    <div
      class="tvc-home-intro__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
        style="--animation-order: 2;"
      {% endif %}
    >
      <lottie-player
        class="tvc-home-intro__lottie"
        src="{{ 'TVC-leaf-pulse.json' | asset_url }}"
        background="transparent"
        renderer="svg"
        loop
        autoplay
        aria-hidden="true"
      ></lottie-player>
      {%- if section.settings.media_text != blank -%}
        <div class="tvc-home-intro__media-caption rte">{{ section.settings.media_text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.tvc-home-intro.name",
  "tag": "section",
  "class": "section section-tvc-home-intro",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.tvc-home-intro.settings.header_anchor.content"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:sections.tvc-home-intro.settings.anchor_id.label",
      "info": "t:sections.tvc-home-intro.settings.anchor_id.info",
      "default": "our-story"
    },
    {
      "type": "header",
      "content": "t:sections.tvc-home-intro.settings.header_content.content"
    },
    {
      "type": "text",
      "id": "pre_title",
      "label": "t:sections.tvc-home-intro.settings.pre_title.label",
      "default": "Trusted personal care — since 1991"
    },
    {
      "type": "html",
      "id": "title",
      "label": "t:sections.tvc-home-intro.settings.title.label",
      "info": "t:sections.tvc-home-intro.settings.title.info",
      "default": "Built on trust.\n<span class=\"tvc-title-accent\">Made for</span>\neveryday life."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.tvc-home-intro.settings.text.label",
      "default": "<p>For over 30 years, we've been creating personal care products that help people feel better—body and mind. From a quiet soak to laughter-filled bath time with the kids, our products are designed for moments that restore, relax, and reconnect.</p>"
    },
    {
      "type": "text",
      "id": "secondary_title",
      "label": "t:sections.tvc-home-intro.settings.secondary_title.label",
      "default": "Our new symbol"
    },
    {
      "type": "richtext",
      "id": "secondary_text",
      "label": "t:sections.tvc-home-intro.settings.secondary_text.label",
      "default": "<p>Our new symbol brings our mission to life. Each leaf represents the individuality of the people we serve, with their own routines, needs, and moments of personal care. Together, the leaves form something bigger: a family of brands united by a shared purpose of making everyday life a little better.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.tvc-home-intro.settings.header_media.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.tvc-home-intro.settings.image.label"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.tvc-home-intro.settings.video.label",
      "info": "t:sections.tvc-home-intro.settings.video.info"
    },
    {
      "type": "richtext",
      "id": "media_text",
      "label": "t:sections.tvc-home-intro.settings.media_text.label",
      "info": "t:sections.tvc-home-intro.settings.media_text.info",
      "default": "<p><strong>TVC Group</strong><br>A family of brands united by a shared purpose of making everyday life a little better.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.tvc-home-intro.presets.name",
      "category": "Homepage"
    }
  ]
}
{% endschema %}
